# Copy to .env.local and fill in once the Supabase project exists (Project Settings → API).
# Leave these empty to run in device-only mode (no sign-in, data stays in the browser).
VITE_SUPABASE_URL=
# The publishable key (sb_publishable_…) or the legacy anon key. Both are safe in the browser.
VITE_SUPABASE_KEY=
